{
  "name": "workflow-studio",
  "publisher": "fesnguyen",
  "version": "1.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/fesnguyen/workflow-studio.git"
  },
  "main": "./out/extension.cjs",
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "onCommand:workflowStudio.openEditor"
  ],
  "categories": [
    "Visualization"
  ],
  "contributes": {
    "commands": [
      {
        "command": "workflowStudio.openEditor",
        "title": "Workflow Studio: Open Editor"
      }
    ]
  },
  "files": [
    "out/extension.cjs",
    "dist/webview/**",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc --noEmit -p tsconfig.extension.json && tsc --noEmit -p tsconfig.extension.test.json && vite build && esbuild src/extension/extension.ts --bundle --platform=node --format=cjs --external:vscode --alias:@=./src --outfile=out/extension.cjs",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:extension": "pnpm build && esbuild test/extension/runner.ts --bundle --platform=node --format=cjs --external:vscode --external:mocha --outfile=out/test/runner.cjs && node test/run-extension-tests.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "elkjs": "^0.12.1",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/mocha": "^10.0.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.90.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vscode/vsce": "^3.6.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "mocha": "^11.7.5",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "@vscode/test-electron": "^2.5.2"
  },
  "description": "Visual workflow editor and simulator: one project, many workflows, many use cases."
}
